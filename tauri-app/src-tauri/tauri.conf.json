{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小乖的考公错题屋", "version": "0.3.0", "identifier": "com.deca.wrong-answer.tauri",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "小乖的考公错题屋", "width": 1280, "height": 860, "minWidth": 960, "minHeight": 640, "dragDropEnabled": false, "visible": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'" }
  },
  "bundle": { "active": true, "targets": ["app"], "category": "Education", "icon": ["icon.png"], "resources": { "../runtime/": "runtime/", "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" }, "macOS": { "signingIdentity": "-", "hardenedRuntime": false }, "shortDescription": "个人错题复盘、学习计划与知识归纳" }
}
