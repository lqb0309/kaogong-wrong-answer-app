  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "scripts": {
    "postinstall": "electron-rebuild",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:review": "electron scripts/review-integration.cjs",
    "test:fenbi": "electron scripts/fenbi-page-test.cjs",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "pack:fast": "electron-vite build && electron-builder --dir -c.mac.identity=null",
    "dist:fast": "electron-vite build && electron-builder -c.mac.identity=null"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "antd": "^5.22.7",
    "better-sqlite3": "13.0.3",
    "dayjs": "^1.11.13",
    "fs-extra": "^11.2.0",
    "katex": "0.19.0",
    "openai": "^4.77.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.14.5",
    "react-router-dom": "7.18.4",
    "recharts": "^2.15.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
